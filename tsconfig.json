{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "strict": false,               // 保留 false，避免干扰现有代码
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "allowJs": true,               // 允许 JS/TS 混用（关键）
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]             // 确保 @ 路径别名生效
    },
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./types",
    // 新增：加载 Vitest 全局类型（解决 vi 命名空间问题）
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.js", "env.d.ts"]
}